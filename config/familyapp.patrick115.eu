server {
        listen 80;
        listen [::]:80;
    
        server_name familyapp.patrick115.eu;
    
        return 301 https://$host$request_uri;
    
}
    
server {
    
        listen [::]:443 ssl http2; 
        listen 443 ssl http2;

        server_name familyapp.patrick115.eu;
    
        access_log /opt/NodeApps/FamilyApp/logs/access.log;
        error_log /opt/NodeApps/FamilyApp/logs/error.log;

        location ~* (sw\.js|registerSW\.js|push-worker\.js|workbox-.*\.js|manifest\.webmanifest)$ {
            proxy_set_header   X-Real-IP          $remote_addr;
            proxy_pass "http://127.0.0.1:5181";
            add_header Cache-Control "no-cache, no-store, must-revalidate, max-age=0" always;
        }

        location / {
            proxy_set_header   X-Real-IP          $remote_addr;
            proxy_pass "http://127.0.0.1:5181";
        }
}
